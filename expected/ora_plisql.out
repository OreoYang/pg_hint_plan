-- Test mode 'after': execute queries after each commit/rollback
do $$
declare
  i int;
begin
  for i in 0..3 loop
    -- Mix commits and rollbacks.
    if i % 2 = 0 then
      commit;
    else
      rollback;
    end if;

    perform test_hint_queries(i, 0);
    insert into test_hint_tab (a) values (i);
  end loop;
end $$;
